# ---- Required ----
# Encrypts stored secrets. Generate with: openssl rand -base64 32
# Keep it stable across restarts or stored secrets become unreadable.
CAIRN_SECRET_KEY=

# ---- Server ----
# CAIRN_HOST=127.0.0.1
# CAIRN_PORT=5175
# CAIRN_DATA_DIR=./data
# Require a bearer token on API and UI:
# CAIRN_API_TOKEN=

# ---- AI provider (optional; the platform works fully without one) ----
# none  = uses the built-in local heuristics (deterministic, offline)
# local = deterministic rule-based analysis (offline, no data leaves the host)
# openai-compatible = OpenAI, Ollama, vLLM, OpenRouter, LM Studio…
# anthropic = Anthropic API
# CAIRN_AI_KIND=none
# CAIRN_AI_BASE_URL=http://localhost:11434/v1
# CAIRN_AI_API_KEY=
# CAIRN_AI_MODEL=
# CAIRN_AI_TIMEOUT_MS=60000

# ---- Policy ----
# Comma-separated host allowlist for HTTP/browser steps. Empty = allow all.
# Example: CAIRN_NETWORK_ALLOWLIST=api.example.com,*.internal.example.com
# CAIRN_NETWORK_ALLOWLIST=
# CAIRN_MAX_NETWORK_REQUESTS=500
# CAIRN_BROWSER_HEADLESS=true

# ---- Logging ----
# CAIRN_LOG_LEVEL=info
