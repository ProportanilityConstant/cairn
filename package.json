{
  "name": "cairn",
  "version": "0.1.0",
  "private": true,
  "description": "Cairn \u2014 evidence-first automation and QA. AI plans, a deterministic engine executes, evidence proves.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/ai packages/executor apps/server && npm --prefix apps/web run build",
    "test": "vitest run",
    "dev:server": "npm run dev --prefix apps/server",
    "dev:web": "npm run dev --prefix apps/web",
    "start": "node apps/server/dist/index.js"
  },
  "devDependencies": {
    "@fastify/static": "^8",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "zod": "3.23.8"
  }
}